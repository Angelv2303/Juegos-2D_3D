# Modo local: instala Ollama y descarga gemma3:4b (ver README.md).
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=gemma3:1b
OLLAMA_NUM_CTX=1024
OLLAMA_TEMPERATURE=0.65
OLLAMA_KEEP_ALIVE=5m

# Opcional: Ollama Cloud. Al definir OLLAMA_API_KEY, la URL y el modelo
# predeterminados serán https://ollama.com y gemma4:31b.
# OLLAMA_API_KEY=tu_clave_de_ollama
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_TEXT_MODEL=gemma4:31b

# Imágenes locales con ComfyUI (no requiere clave API).
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly-fp16.safetensors
COMFYUI_AUTO_START=true
COMFYUI_WIDTH=512
COMFYUI_HEIGHT=512
COMFYUI_STEPS=16
COMFYUI_SAMPLER=dpmpp_2m
COMFYUI_SCHEDULER=karras
COMFYUI_CFG=6.5
# Opcional: LoRA LCM de SD 1.5 instalado en ComfyUI/models/loras.
# Al definirlo, la app usa sampler lcm, 8 pasos y CFG 1.5.
# COMFYUI_LCM_LORA=lcm-lora-sd15.safetensors
# Opcional: carpeta de instalación si ComfyUI no está en su ubicación predeterminada.
# COMFYUI_INSTALL_DIR=C:\\Users\\tu_usuario\\AppData\\Local\\EtiquetaIA\\ComfyUI\\ComfyUI_windows_portable

# Voz: browser (predeterminado, sin instalación), piper (local/CPU) u openai (requiere clave).
TTS_PROVIDER=browser
# Para Piper: ruta completa al ejecutable piper.exe y al modelo .onnx de una voz española.
# PIPER_PATH=C:\\Users\\tu_usuario\\AppData\\Local\\Programs\\Python\\Python312\\Scripts\\piper.exe
# PIPER_VOICE=C:\\IA\\voices\\<archivo-de-voz>.onnx

# Opcional: proveedor anterior de OpenAI.
# AI_PROVIDER=openai
# OPENAI_API_KEY=tu_clave_openai
# OPENAI_TEXT_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

HOST=127.0.0.1
PORT=8765
